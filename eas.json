{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "ANDROID_HOME": "/opt/homebrew/share/android-commandlinetools",
        "JAVA_HOME": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "ANDROID_HOME": "/opt/homebrew/share/android-commandlinetools",
        "JAVA_HOME": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ANDROID_HOME": "/opt/homebrew/share/android-commandlinetools",
        "JAVA_HOME": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home"
      }
    }
  },
  "submit": {
    "production": {}
  }
}